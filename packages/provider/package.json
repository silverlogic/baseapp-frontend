{
  "name": "@baseapp-frontend/provider",
  "description": "Providers for React Query and Emotion.",
  "version": "4.0.0",
  "main": "./index.ts",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc --build tsconfig.build.json",
    "dev": "rm -rf dist && tsc --watch",
    "test:unit": "rm -rf dist && vitest run --config ./vitest.config.mts",
    "lint": "eslint . --ext .tsx --ext .ts --cache && tsc --noEmit --incremental",
    "storybook": "echo Provider: No storybook found",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "lodash": "catalog:"
  },
  "peerDependencies": {
    "@baseapp-frontend/utils": "workspace:*",
    "react": "catalog:react19"
  },
  "devDependencies": {
    "@baseapp-frontend/config": "workspace:*",
    "@baseapp-frontend/eslint-plugin": "workspace:*",
    "@baseapp-frontend/test": "workspace:*",
    "@baseapp-frontend/tsconfig": "workspace:*",
    "@testing-library/react": "catalog:test",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:test",
    "@vitest/coverage-v8": "catalog:test",
    "jsdom": "catalog:test",
    "typescript": "catalog:",
    "vitest": "catalog:test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/silverlogic/baseapp-frontend.git",
    "directory": "packages/provider"
  },
  "bugs": {
    "url": "https://github.com/silverlogic/baseapp-frontend/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
