{
  "extends": "@baseapp-frontend/tsconfig/lib.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "outDir": "./dist"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".eslintrc.js",
    "*.ts",
    "*.tsx",
    "index.d.ts",
    "vitest.config.mts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
