{
  "name": "baseapp-frontend",
  "description": "A modularized package system for TSL's frontend baseapp.",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:ast-grep": "ast-grep test && ast-grep scan",
    "test:unit": "turbo run test:unit",
    "test:component": "turbo run test:component",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "storybook": "turbo storybook",
    "clean": "turbo clean && git clean -xdf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "restore-catalogs": "node .scripts/restore-catalogs.js",
    "replace-catalogs": "node .scripts/replace-catalogs.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:lint",
    "@changesets/cli": "^2.27.11",
    "@types/node": "catalog:",
    "eslint": "catalog:lint",
    "husky": "catalog:lint",
    "lint-staged": "catalog:lint",
    "prettier": "catalog:lint",
    "turbo": "^2.5.3",
    "typescript": "catalog:",
    "yaml": "^2.8.3"
  },
  "lint-staged": {
    "apps/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@10.28.2",
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": ">=0.9.10",
      "brace-expansion@^1.0.0": ">=1.1.18 <2",
      "brace-expansion@^2.0.0": ">=2.1.4 <3",
      "brace-expansion@^5.0.0": ">=5.0.9",
      "esbuild": ">=0.28.1",
      "form-data": ">=4.0.6",
      "js-yaml": ">=4.3.1 <5",
      "read-yaml-file>js-yaml": "^3.15.1",
      "nanoid@^3.0.0": ">=3.3.17 <4",
      "postcss": ">=8.5.23",
      "sharp@^0.34.0": ">=0.35.3",
      "shell-quote": ">=1.9.0",
      "uuid": ">=14.0.0",
      "ws@^8.0.0": ">=8.21.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "isomorphic-ws>ws": "8"
      }
    }
  }
}
